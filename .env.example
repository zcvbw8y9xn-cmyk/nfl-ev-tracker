# Optional API keys to maximize data sources on future refreshes.
# Leave blank to use all built-in free/scrapable sources (ALC Proline, Pinnacle, Covers, BettingPros, Action Network, ScoresAndOdds, ESPN).

# The Odds API (https://the-odds-api.com - free tier: 500 req/mo)
THE_ODDS_API_KEY=

# PropLine API (https://prop-line.com - free tier: 1,000 req/day)
PROPLINE_API_KEY=

# Balldontlie NFL Player Props API (https://www.balldontlie.io)
BALLDONTLIE_API_KEY=

# SportsGameOdds API (https://sportsgameodds.com)
SPORTSGAMEODDS_API_KEY=

# Google Sheets ID (auto-populated after first run if you want to update in-place)
SPREADSHEET_ID=
